# Vorlage: kopieren nach .env und ausfüllen (`cp .env.example .env`).
# .env ist per .gitignore ausgeschlossen und gehört nie ins Repository.
# In der Streamlit Cloud stehen dieselben Namen unter Advanced settings → Secrets.

# Secret der internen Notion-Integration (Prefix ntn_ oder secret_).
# Notion → Settings → Connections → Develop or manage integrations.
NOTION_TOKEN=

# 32-stellige ID aus der URL der Datenbank „Rezepte".
NOTION_DATABASE_ID=

# Optional: überspringt das Nachschlagen der Data-Source-ID beim Start.
NOTION_DATA_SOURCE_ID=

# Key von console.anthropic.com. Vorher dort ein Monats-Spending-Limit setzen.
ANTHROPIC_API_KEY=

# Optional, Standard claude-sonnet-5.
ANTHROPIC_MODEL=

# true blendet „Verarbeiten" und „Fehler" ein. Standard false.
# Im öffentlichen Deployment zwingend false, sonst kann jeder Besucher
# die Notion-Datenbank verändern.
REZEPTE_SCHREIBZUGRIFF=false

# LLM-Fragen pro Browser-Sitzung, Standard 25, 0 = kein Limit.
REZEPTE_CHAT_LIMIT=25
